# Porta do servidor HTTP (padrão: 3000)
PORT=3000

# Diretório onde o banco SQLite será criado (padrão: ./data)
DATA_DIR=./data

# ----- WhatsApp Business API (Meta Cloud API) -----
# Token de acesso permanente gerado no Meta for Developers
WA_TOKEN=

# ID do número de telefone cadastrado no WhatsApp Business
WA_PHONE_ID=

# Token de verificação do webhook (você escolhe, configure o mesmo no painel Meta)
WA_VERIFY_TOKEN=delas-verify

# App Secret do aplicativo Meta (usado para validar assinatura dos webhooks)
# Encontrado em: Meta for Developers → seu app → Configurações → Básico
WA_APP_SECRET=
